[Unit]
Description=copy-trader-sol
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=trader
Group=trader
WorkingDirectory=/opt/copy-trader-sol
EnvironmentFile=/opt/copy-trader-sol/.env
ExecStart=/usr/bin/node --enable-source-maps dist/index.js
Restart=on-failure
RestartSec=15s
StartLimitBurst=5
StartLimitIntervalSec=120

# Sandbox
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/opt/copy-trader-sol/data
LimitNOFILE=65536

# Graceful shutdown lets Node close WS + DB cleanly.
KillSignal=SIGINT
TimeoutStopSec=20s

[Install]
WantedBy=multi-user.target
