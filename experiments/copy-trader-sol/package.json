{
  "name": "copy-trader-sol",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "Copy-trade Solana wallets you follow. Jupiter-routed swaps, stop-loss + trailing take-profit, rug check, auto-mute losing leaders, kill switch, live dashboard, CLI.",
  "scripts": {
    "setup": "tsx src/setup.ts",
    "build": "tsc",
    "start": "node --enable-source-maps dist/index.js",
    "dev": "tsx src/index.ts",
    "cli": "tsx src/cli.ts",
    "smoke": "tsx src/smoke.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@solana/web3.js": "^1.95.3",
    "better-sqlite3": "^11.3.0",
    "bs58": "^6.0.0",
    "dotenv": "^16.4.5",
    "pino": "^9.4.0",
    "pino-pretty": "^11.2.2",
    "undici": "^6.19.8"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^22.5.4",
    "tsx": "^4.19.0",
    "typescript": "^5.6.2",
    "vitest": "^2.1.1"
  }
}
