# === REQUIRED ===
HELIUS_API_KEY=your_helius_key_here
RPC_URL=https://mainnet.helius-rpc.com/?api-key=${HELIUS_API_KEY}
WS_URL=wss://mainnet.helius-rpc.com/?api-key=${HELIUS_API_KEY}
WALLET_SECRET_KEY=

# Optional extra RPC URLs to race sends against (comma-separated).
# The bot submits the same signed tx to all senders and takes whichever confirms first.
EXTRA_RPC_URLS=

# === WHO TO COPY ===
FOLLOWED_WALLETS=
AUTO_DISCOVER=0
AUTO_DISCOVER_COUNT=5
AUTO_DISCOVER_REFRESH_MINUTES=240

# === SIZING ===
FIXED_BUY_SOL=0.02
LEADER_PERCENT=0
MAX_CONCURRENT_POSITIONS=5
MIN_LEADER_SOL_LAMPORTS=100000000

# === EXITS ===
STOP_LOSS_PCT=0.30
TAKE_PROFIT_PCT=1.0
TRAILING_STOP_PCT=0.20
PRICE_CHECK_INTERVAL_SEC=20
# Auto-exit any position older than N hours regardless of PnL (0 = never).
MAX_POSITION_AGE_HOURS=0

# === EXECUTION ===
SLIPPAGE_BPS=150
PRIORITY_FEE_MICROLAMPORTS=100000
# Cap the auto-tune ceiling — retries double the fee up to this.
PRIORITY_FEE_MICROLAMPORTS_MAX=2000000
EXECUTION_MAX_ATTEMPTS=3

# === JITO (bundle submission for MEV protection + speed) ===
JITO_ENABLED=0
JITO_BLOCK_ENGINE_URL=https://mainnet.block-engine.jito.wtf/api/v1/bundles
JITO_TIP_LAMPORTS=10000

# === FILTERS ===
MIN_LIQUIDITY_USD=25000
# Skip mints newer than this many minutes (0 = allow any age).
MIN_TOKEN_AGE_MINUTES=5
# If we can't determine age, treat as too-young when strict is on.
STRICT_TOKEN_AGE=0
# Only buy when at least N distinct leaders bought this mint within the window.
CONSENSUS_MIN_LEADERS=1
CONSENSUS_WINDOW_SEC=90
# After you sell a mint, don't rebuy it for this many minutes.
MINT_REENTRY_COOLDOWN_MINUTES=60
# After you copy a leader's buy, ignore further buys from them for this many minutes.
LEADER_REBUY_COOLDOWN_MINUTES=5

# === SAFETY ===
DAILY_LOSS_LIMIT_SOL=0.5
BLACKLIST_MINTS=
RUG_CHECK_ENABLED=1
# KILL_SWITCH_PATH=/Users/you/.copy-trader-kill

# === AUTO-MUTE (drops leaders who cost you money) ===
AUTO_MUTE_ENABLED=1
AUTO_MUTE_MIN_TRADES=5
AUTO_MUTE_WIN_RATE_FLOOR=0.35
AUTO_MUTE_LOSS_STREAK=4

# === ALERTS ===
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=

# === OBSERVABILITY ===
ENABLE_DASHBOARD=1
DASHBOARD_PORT=3000
ENABLE_METRICS=1
METRICS_PORT=9090

# === WALLET MONITOR ===
# Alert when wallet SOL balance drops below this.
WALLET_BALANCE_ALERT_SOL=0.05
BALANCE_CHECK_INTERVAL_MINUTES=10
BALANCE_ALERT_COOLDOWN_HOURS=6

# === STARTUP TASKS ===
# Unwrap stray wSOL sitting in the wallet's ATA on startup (from failed Jupiter swaps).
WSOL_CLEANUP_ON_START=1

# === LOGGING ===
# When set, mirror logs to this file (per-day rotation via ".<YYYY-MM-DD>" suffix).
# LOG_FILE=./data/logs/bot.log

# === MODE ===
DRY_RUN=1
LOG_LEVEL=info
