# --- RPC ---
# Get a free Helius key at https://helius.dev — WebSocket endpoint is used for realtime, RPC for tx fetch + sends.
HELIUS_API_KEY=your_helius_key_here
RPC_URL=https://mainnet.helius-rpc.com/?api-key=${HELIUS_API_KEY}
WS_URL=wss://mainnet.helius-rpc.com/?api-key=${HELIUS_API_KEY}

# --- Your trading wallet ---
# Base58-encoded secret key (what Phantom exports). NEVER commit this.
WALLET_SECRET_KEY=

# --- Wallets to copy (comma-separated Solana addresses) ---
# Add wallets you have vetted. See README for how to discover top wallets.
FOLLOWED_WALLETS=

# --- Sizing & risk ---
# Fixed SOL amount to spend on each copied buy. Overrides percentage mode when set.
FIXED_BUY_SOL=0.05
# Or: percentage of the leader's SOL notional you'll match (0.0 disables).
LEADER_PERCENT=0
# Max SOL you're willing to lose in one 24h window before the bot pauses itself.
DAILY_LOSS_LIMIT_SOL=0.5
# Slippage tolerance in basis points (100 = 1%).
SLIPPAGE_BPS=150
# Skip tokens with less than this in USD liquidity (rough anti-rug filter).
MIN_LIQUIDITY_USD=25000
# Priority fee micro-lamports per CU. Higher = faster inclusion.
PRIORITY_FEE_MICROLAMPORTS=100000

# --- Mode ---
# DRY_RUN=1 logs what it would do but sends no transactions. Start here.
DRY_RUN=1

LOG_LEVEL=info
