# === REQUIRED ===

# Free key at https://helius.dev (100k credits/day is enough to start)
HELIUS_API_KEY=your_helius_key_here
RPC_URL=https://mainnet.helius-rpc.com/?api-key=${HELIUS_API_KEY}
WS_URL=wss://mainnet.helius-rpc.com/?api-key=${HELIUS_API_KEY}

# Base58 secret (what Phantom exports). NEVER commit real one.
WALLET_SECRET_KEY=

# === FOLLOWED WALLETS ===
# Comma-separated Solana addresses. Get them from https://gmgn.ai (Smart Money tab).
FOLLOWED_WALLETS=

# Or auto-discover: pull top wallets by 7d PnL, refresh every N minutes.
AUTO_DISCOVER=0
AUTO_DISCOVER_COUNT=5
AUTO_DISCOVER_REFRESH_MINUTES=240

# === SIZING ===
# Fixed SOL per copied buy (overrides percent mode when set).
FIXED_BUY_SOL=0.02
# Or: percent of leader's SOL notional (0 disables).
LEADER_PERCENT=0
# Hard cap on simultaneous open positions.
MAX_CONCURRENT_POSITIONS=5
# Ignore leader trades smaller than this SOL notional (lamports; 1e8 = 0.1 SOL).
MIN_LEADER_SOL_LAMPORTS=100000000

# === EXITS (critical) ===
# Stop-loss: exit if position drops this % below entry.
STOP_LOSS_PCT=0.30
# Take-profit trigger: after +this %, arm the trailing stop.
TAKE_PROFIT_PCT=1.0
# Trailing stop: after take-profit trigger, exit if price drops this % from peak.
TRAILING_STOP_PCT=0.20
# How often to poll prices for open positions.
PRICE_CHECK_INTERVAL_SEC=20

# === DAILY GUARDS ===
DAILY_LOSS_LIMIT_SOL=0.5
SLIPPAGE_BPS=150
MIN_LIQUIDITY_USD=25000
PRIORITY_FEE_MICROLAMPORTS=100000

# Comma-separated mints to never touch.
BLACKLIST_MINTS=

# === KILL SWITCH ===
# Create this file (touch ~/.copy-trader-kill) to pause instantly without shutdown.
# KILL_SWITCH_PATH=/Users/you/.copy-trader-kill

# === NOTIFICATIONS (optional) ===
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# === DASHBOARD ===
ENABLE_DASHBOARD=1
DASHBOARD_PORT=3000

# === MODE ===
# ALWAYS start with DRY_RUN=1. Only flip to 0 after 24h of clean paper trading.
DRY_RUN=1
LOG_LEVEL=info
